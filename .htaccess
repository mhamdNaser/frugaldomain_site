<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # One canonical origin. www and http duplicates split ranking signals and
  # show up in Search Console as separate properties, so fold them into
  # https://frugaldomain.site before anything else runs.
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://frugaldomain.site%{REQUEST_URI} [R=301,L]
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # Let real files and directories pass through.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Apps published under /apps/<slug>/ are self-contained builds with their own
  # index.html and their own routing. A deep link inside one must never fall
  # through to this SPA's index.html, or the app would boot Fruga instead.
  # /apps and /apps/ themselves are left alone so the gallery route still works:
  # the prerendered apps/index.html is a real file and is matched by the rule
  # above, and each app folder carries its own .htaccess for internal routes.
  RewriteRule ^apps/.+ - [L]

  # SPA fallback.
  RewriteRule . /index.html [L]
</IfModule>

# Vite fingerprints every file in /assets, so those URLs can be cached
# indefinitely. HTML must never be cached or visitors keep booting an old
# bundle after a deploy.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType text/javascript           "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/jpeg                "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType image/x-icon              "access plus 1 year"
  ExpiresByType font/woff2                "access plus 1 year"
  ExpiresByType text/html                 "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|mjs|png|jpe?g|gif|svg|webp|ico|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # Crawlers must always read the current sitemap and robots rules.
  <FilesMatch "^(sitemap\.xml|robots\.txt)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Text assets are served compressed; this is what "enable text compression"
# in PageSpeed asks for.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript text/javascript
  AddOutputFilterByType DEFLATE application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Googlebot rejects a sitemap served as text/plain or octet-stream.
<IfModule mod_mime.c>
  AddType application/xml .xml
  AddType text/plain .txt
</IfModule>
