# The trailing-slash handling below decides for itself when a directory URL
# gets a slash; the server must not add one first.
<IfModule mod_dir.c>
  DirectorySlash Off
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # One canonical origin. www and http duplicates split ranking signals and
  # show up in Search Console as separate properties, so fold them into
  # https://frugaldomain.site before anything else runs.
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://frugaldomain.site%{REQUEST_URI} [R=301,L]
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # ---------------------------------------------------------------------------
  # Developer tools moved to frugaldomain.online (permanent). Before every
  # snapshot and fallback rule: those would answer 200 with another page.
  # Arabic keeps /ar/; the root, /hi, /zh and /tr go to /en/.
  # ---------------------------------------------------------------------------
  RewriteRule ^ar/(token-calculator|agents-md|tool-schema|prompt-library|jsonl-validator|arabic-text|json-toolkit|text-diff|jwt-decoder|cron-builder|mock-data|svg-toolkit|favicon-generator|og-image|code-image|playground)/?$ https://frugaldomain.online/ar/tools/$1 [R=301,L]
  RewriteRule ^(?:(?:hi|zh|tr)/)?(token-calculator|agents-md|tool-schema|prompt-library|jsonl-validator|arabic-text|json-toolkit|text-diff|jwt-decoder|cron-builder|mock-data|svg-toolkit|favicon-generator|og-image|code-image|playground)/?$ https://frugaldomain.online/en/tools/$1 [R=301,L]
  RewriteRule ^ar/convert/(jpg-to-png|png-to-webp)/?$ https://frugaldomain.online/ar/tools/$1 [R=301,L]
  RewriteRule ^(?:(?:hi|zh|tr)/)?convert/(jpg-to-png|png-to-webp)/?$ https://frugaldomain.online/en/tools/$1 [R=301,L]
  RewriteRule ^ar/tools/?$ https://frugaldomain.online/ar/tools/ [R=301,L]
  RewriteRule ^(?:(?:hi|zh|tr)/)?tools/?$ https://frugaldomain.online/en/tools/ [R=301,L]
  RewriteRule ^ar/components/?$ https://frugaldomain.online/ar/tools/component-library [R=301,L]
  RewriteRule ^(?:(?:hi|zh|tr)/)?components/?$ https://frugaldomain.online/en/tools/component-library [R=301,L]
  # The component's slug travels in the fragment; NE keeps the # literal.
  RewriteRule ^ar/components/([A-Za-z0-9_-]+)/?$ https://frugaldomain.online/ar/tools/component-library#c=$1 [R=301,NE,L]
  RewriteRule ^(?:(?:hi|zh|tr)/)?components/([A-Za-z0-9_-]+)/?$ https://frugaldomain.online/en/tools/component-library#c=$1 [R=301,NE,L]

  # scripts/ holds server-side helpers and checks (appearance-lib.php, deploy-build.sh):
  # PHP includes them from disk; nothing there is for the web.
  RewriteRule ^scripts(/|$) - [F,L]

  # The developer profile shipped for a while at an all-lowercase path. The
  # prerenderer writes one directory per route and this host is case-sensitive,
  # so only the /About-Us spelling has a snapshot behind it; the lowercase one
  # fell through to the SPA fallback and answered 200 with the home page's
  # markup. Redirect rather than drop it, so the indexed URL keeps its signals.
  RewriteRule ^about-us/muhammed-nasser-edden/?$ /About-Us/muhammed-nasser-edden [R=301,L]
  RewriteRule ^ar/about-us/muhammed-nasser-edden/?$ /ar/About-Us/muhammed-nasser-edden [R=301,L]

  # The documentation page was removed; its indexed addresses go to the home page.
  RewriteRule ^(?:(ar|hi|zh|tr)/)?documentation/?$ /$1 [R=301,L]

  # The theme stylesheet is generated by appearance.php. It goes before the
  # prerender rules and the file passthrough below, which would otherwise end
  # at the SPA fallback (or a 404, for a .css that is not on disk).
  RewriteRule ^appearance\.css$ /appearance.php [L]

  # Every prerendered route is a directory holding index.html, and the server's
  # default for a directory requested without a trailing slash is a 301 that
  # adds one. The canonicals, hreflang and sitemap all name the slashless URL,
  # so Google was sent /tools -> 301 -> /tools/, whose canonical points back at
  # /tools. With no URL to settle on, most of the site sat in "Discovered -
  # currently not indexed". Serve each snapshot at its slashless URL, and fold
  # the slashed spelling into it.
  #
  # /apps/<slug>/ is left out: those builds load ./assets relative to their
  # directory, so they need the slash, and get it explicitly below.
  RewriteCond %{REQUEST_URI} !^/apps/[^/]+
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # The five home pages carry the admin's home sections (see home-preview.php).
  # After the slash fold above (so /ar/ still redirects to /ar) and before the
  # snapshot rule below, which would serve /ar as the plain file.
  RewriteRule ^(?:(ar|hi|zh|tr)/?)?$ /home-preview.php?lang=$1 [L,QSA]

  RewriteCond %{REQUEST_URI} !^/apps/[^/]+
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.+[^/])$ /$1/index.html [L]

  # /apps/<slug> is the app's page on this site (AppDetails), the address its
  # canonical and the sitemap name; /apps/<slug>/ is the published app itself.
  # Redirecting the first to the second kept every app page out of Google.
  RewriteRule ^apps/[^/]+$ /app-shell.html [L]

  # Let real files and directories pass through.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # A static file that is not on disk must fail as a missing file, not fall
  # through to the app's html. A module script answered with html fails as
  # "Failed to fetch dynamically imported module" - which is what a tab left
  # open across a deploy saw, because its chunk names no longer existed - and a
  # stylesheet or an image answered with html fails silently and strangely.
  RewriteRule \.(js|mjs|css|map|png|jpe?g|gif|svg|webp|ico|avif|woff2?|json|csv|pdf)$ - [R=404,L]

  # Apps published under /apps/<slug>/ are self-contained builds with their own
  # index.html and their own routing. A deep link inside one must never fall
  # through to this SPA's index.html, or the app would boot Fruga instead.
  # /apps and /apps/ themselves are left alone so the gallery route still works:
  # the prerendered apps/index.html is a real file and is matched by the rule
  # above, and each app folder carries its own .htaccess for internal routes.
  RewriteRule ^apps/.+ - [L]

  # A shared form link is served by a small script that puts that form's own
  # title and description into the page's head. Crawlers do not run
  # javascript, so without this every form previewed as the home page - the
  # one card a person judges the link by before tapping it.
  RewriteRule ^(ar/)?f/([A-Za-z0-9_-]+)/?$ /form-preview.php?handle=$2 [L,QSA]

  # A lesson is served the same way, so a search engine reads that lesson's
  # own title, description and hreflang in the address's language rather than
  # the home page's (see learn-preview.php).
  RewriteRule ^(?:(ar|hi|zh|tr)/)?learn/([A-Za-z0-9_-]+)/([A-Za-z0-9_-]+)/?$ /learn-preview.php?lang=$1&course=$2&lesson=$3 [L,QSA]
  # Courses and marketplace items: their text, title and canonical
  # for crawlers (page-preview.php), the same way lessons get theirs.
  RewriteRule ^(?:(ar|hi|zh|tr)/)?learn/([A-Za-z0-9_-]+)/?$ /page-preview.php?kind=course&lang=$1&slug=$2 [L,QSA]
  RewriteRule ^(?:(ar|hi|zh|tr)/)?shopify/(themes|apps)/([A-Za-z0-9_-]+)/?$ /page-preview.php?kind=market&lang=$1&type=$2&slug=$3 [L,QSA]

  # SPA fallback.
  # The bare app page, not index.html: that one is the prerendered home page,
  # and its text and canonical made every page without a snapshot a copy of "/".
  RewriteRule . /app-shell.html [L]
</IfModule>

# Vite fingerprints every file in /assets, so those URLs can be cached
# indefinitely. HTML must never be cached or visitors keep booting an old
# bundle after a deploy.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType text/javascript           "access plus 1 year"
  # A day, for the same reason as the header block below: these names do not
  # change when their contents do.
  ExpiresByType image/png                 "access plus 1 day"
  ExpiresByType image/jpeg                "access plus 1 day"
  ExpiresByType image/svg+xml             "access plus 1 day"
  ExpiresByType image/webp                "access plus 1 day"
  ExpiresByType image/x-icon              "access plus 1 day"
  ExpiresByType font/woff2                "access plus 1 year"
  ExpiresByType text/html                 "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  # Vite fingerprints these, so the same name is always the same bytes.
  <FilesMatch "\.(css|js|mjs|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Images keep their names across deploys - favicon.ico, og-cover.png, the
  # logo - so "immutable" froze them. A new logo was then invisible for a year
  # to anything that had fetched the old one, which is exactly what happened:
  # the icon beside the search result stayed the previous brand's. A day, and
  # revalidation after it.
  <FilesMatch "\.(png|jpe?g|gif|svg|webp|ico|avif)$">
    Header set Cache-Control "public, max-age=86400, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # Crawlers must always read the current sitemap, robots rules and llms.txt.
  <FilesMatch "^(sitemap\.xml|robots\.txt|llms\.txt)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Text assets are served compressed; this is what "enable text compression"
# in PageSpeed asks for.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript text/javascript
  AddOutputFilterByType DEFLATE application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Googlebot rejects a sitemap served as text/plain or octet-stream.
<IfModule mod_mime.c>
  AddType application/xml .xml
  AddType text/plain .txt
</IfModule>
