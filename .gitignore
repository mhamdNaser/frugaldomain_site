# ---------------------------------------------------------------------------
# Deployment repository. Its layout mirrors the server's public_html:
#
#   /                 -> built React frontend  (frugaldomain.site)
#   /api/public       -> Laravel API           (api.frugaldomain.site)
#   /cdn/public       -> Laravel CDN           (cdn.frugaldomain.site)
# ---------------------------------------------------------------------------

# Frontend source. Built locally; only the compiled output is deployed.
/sydev-front/

# Secrets and environment files - create these directly on the server.
.env
.env.*
!.env.example

# Dependencies (installed on the server with `composer install --no-dev`).
/api/vendor/
/cdn/vendor/
node_modules/

# Laravel runtime state.
/api/storage/*.key
/api/storage/framework/cache/data/*
/api/storage/framework/sessions/*
/api/storage/framework/views/*
/api/storage/framework/testing/*
/api/storage/logs/*
/api/bootstrap/cache/*.php
/cdn/storage/*.key
/cdn/storage/framework/cache/data/*
/cdn/storage/framework/sessions/*
/cdn/storage/framework/views/*
/cdn/storage/logs/*
/cdn/bootstrap/cache/*.php

# Keep the directory structure Laravel expects.
!**/storage/**/.gitignore
!**/bootstrap/cache/.gitignore

# Local scratch / debug files.
*.log
*.sqlite
*.sqlite-journal
/api/tmp_debug_*.php
/api/test.json
/api/list.txt
/api/projectStructure.json
/api/public/*.sql

# Editors / OS.
.DS_Store
Thumbs.db
.idea/
.vscode/
.fleet/
.nova/
.zed/
*.suo
*.swp

# Claude Code local settings.
/.claude/
